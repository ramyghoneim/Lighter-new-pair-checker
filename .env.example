# Lighter Pair Monitor Configuration

# Storage directory for tracking pairs
STORAGE_DIR=.data

# Notification type: console, email, webhook, discord
NOTIFICATION_TYPE=console

# Email Notifications
EMAIL_ENABLED=false
EMAIL_FROM=your-email@gmail.com
EMAIL_TO=recipient@example.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Webhook Notifications
WEBHOOK_ENABLED=false
WEBHOOK_URL=https://your-webhook-url.com/webhook

# Discord Notifications
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=https://discordapp.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Lighter API
LIGHTER_API_URL=https://api.lighter.xyz

# Monitoring interval in seconds (default: 300 = 5 minutes)
CHECK_INTERVAL_SECONDS=300
